# Copy to .env and fill in real values locally. NEVER commit .env.
# Every value below is a deliberate fake. Do not paste real keys here.

NODE_ENV=development

# Database (Postgres with PostGIS)
DATABASE_URL=postgres://changeme:changeme@localhost:5432/changeme

# Redis (sessions, queues, rate limits)
REDIS_URL=redis://localhost:6379

# Session and token signing keys. Generate long random values.
SESSION_SECRET=changeme
TRACKING_TOKEN_KEY=changeme

# Payments (Razorpay or Cashfree). Use the provider's test keys locally.
PAYMENT_KEY_ID=changeme
PAYMENT_KEY_SECRET=changeme
PAYMENT_WEBHOOK_SECRET=changeme

# Carrier or aggregator webhook secret
CARRIER_WEBHOOK_SECRET=changeme

# Messaging (SMS / WhatsApp / email)
SMS_API_KEY=changeme
EMAIL_API_KEY=changeme
