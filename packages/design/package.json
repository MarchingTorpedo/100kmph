{
  "name": "@100kmph/design",
  "version": "0.0.0",
  "private": true,
  "description": "Design tokens, fonts and motion utilities for 100kmph (see docs/motion-spec.md)",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./tokens": "./src/tokens.ts",
    "./motion": "./src/motion.ts",
    "./boot": "./src/boot.ts",
    "./velocity-width": "./src/velocity-width.ts",
    "./styles/*": "./styles/*",
    "./fonts/*": "./fonts/*"
  },
  "scripts": {
    "build:css": "node scripts/build-css.ts",
    "check": "node scripts/build-css.ts --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "jsdom": "^30.1.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
