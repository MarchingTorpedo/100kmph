---
// Calm footer with the motion toggle (motion-spec risk 5). The toggle is
// wired in scripts/landing.ts; without JS it simply does nothing.
---

<footer class="site-footer" data-theme="dark">
  <p class="site-footer__note">Preview build. The poster, copy and rider are placeholders.</p>
  <div class="site-footer__motion">
    <button
      type="button"
      class="site-footer__toggle press"
      aria-pressed="false"
      aria-describedby="motion-note"
      data-motion-toggle
    >
      Reduce motion
    </button>
    <span id="motion-note" class="site-footer__hint" role="status" data-motion-note hidden
      >Motion is already reduced by your device settings.</span
    >
  </div>
</footer>

<style>
  .site-footer {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    align-items: center;
    justify-content: space-between;
    padding: var(--space-7) var(--space-4);
    border-top: 1px solid rgb(241 243 246 / 0.1);
    font-size: var(--text-xs);
    color: var(--color-muted);
  }

  .site-footer__note {
    margin: 0;
  }

  .site-footer__motion {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    align-items: center;
  }

  .site-footer__toggle {
    font: inherit;
    font-weight: var(--weight-semibold);
    min-height: 44px;
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-control);
    border: 1px solid var(--color-muted);
    background: transparent;
    color: var(--color-ink);
    cursor: pointer;
  }

  .site-footer__toggle[aria-pressed='true'] {
    background: var(--color-milestone-fill);
    border-color: var(--color-milestone-fill);
    color: var(--color-on-milestone);
  }

  /* OS already reduces motion: still focusable (aria-disabled), visibly inert. */
  .site-footer__toggle[aria-disabled='true'] {
    cursor: default;
    background: transparent;
    border-style: dashed;
    color: var(--color-muted);
  }
</style>
